<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-LPQZLGFJVX"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-LPQZLGFJVX');
  </script>

  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <meta name="keywords" content="{% if tags %}{{ tags | join(', ') }}, {% endif %}Green Beans Coffee, グリーンビーンズコーヒー, GBC, 北参道, 千駄ヶ谷, ダガヤサンドウ, ペット同伴カフェ, 犬同伴カフェ, ペットフレンドリーカフェ, 東京カフェ">

  <!-- OGP -->
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:type" content="{{ ogType if ogType else 'article' }}">
  <meta property="og:site_name" content="Green Beans Coffee ペットアンバサダーサイト">
  <meta property="og:url" content="https://greenbeanscoffeeambassador.com{{ page.url }}">
  {% if thumbnail %}
  <meta property="og:image" content="https://greenbeanscoffeeambassador.com{{ thumbnail }}">
  {% else %}
  <meta property="og:image" content="https://greenbeanscoffeeambassador.com/pets/assets/images/hero/hero-bg-1.jpg">
  {% endif %}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ description }}">
  {% if thumbnail %}
  <meta name="twitter:image" content="https://greenbeanscoffeeambassador.com{{ thumbnail }}">
  {% else %}
  <meta name="twitter:image" content="https://greenbeanscoffeeambassador.com/pets/assets/images/hero/hero-bg-1.jpg">
  {% endif %}

  <link rel="canonical" href="https://greenbeanscoffeeambassador.com{{ page.url }}">
  <link rel="alternate" hreflang="ja" href="https://greenbeanscoffeeambassador.com{{ page.url }}">
  <link rel="alternate" hreflang="x-default" href="https://greenbeanscoffeeambassador.com{{ page.url }}">
  {% if enAlternateUrl %}
  <link rel="alternate" hreflang="en" href="{{ enAlternateUrl }}">
  {% endif %}
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="alternate" type="application/rss+xml" title="Green Beans Coffee コラム" href="https://greenbeanscoffeeambassador.com/feed.xml">

  <!-- CDN: Tailwind CSS v4 -->
  <script src="https://cdn.tailwindcss.com?plugins=forms,typography,aspect-ratio"></script>

  <!-- CDN: Animate.css -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" media="print" onload="this.media='all'" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;700&family=Noto+Serif+JP:wght@400;600&display=swap" rel="stylesheet">

  <style>
    body { font-family: 'Noto Sans JP', sans-serif; }
    h1, h2, h3, h4 { font-family: 'Noto Serif JP', serif; }
    html { scroll-behavior: smooth; overflow-x: hidden; }
  </style>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#4A3728',
            secondary: '#8B7355',
            accent: '#C9A86C',
            background: '#FAF8F5',
            text: '#2D2A26',
          }
        }
      }
    }
  </script>

  <!-- JSON-LD: @graph（Organization + BreadcrumbList + BlogPosting + FAQPage を1本に統合） -->
  <!-- 店舗情報(CafeOrCoffeeShop)はトップページ(/)に集約し、記事ページでは重複出力しない -->
  {% set faqItems = content | extractFAQ %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "name": "Green Beans Coffee",
        "alternateName": "グリーンビーンズコーヒー",
        "url": "https://greenbeanscoffeeambassador.com",
        "logo": {
          "@type": "ImageObject",
          "url": "https://greenbeanscoffeeambassador.com/assets/images/hero_bg-1.jpg",
          "width": 1280,
          "height": 853
        },
        "description": "東京・渋谷区千駄ヶ谷の自家焙煎スペシャルティコーヒー専門店。店名看板のないペットフレンドリーカフェ。グルテンフリーメニューあり。",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "千駄ヶ谷3-30-1 RC APARTMENT 1階",
          "addressLocality": "渋谷区",
          "addressRegion": "東京都",
          "postalCode": "151-0051",
          "addressCountry": "JP"
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+81-3-6447-0681",
          "contactType": "customer service",
          "availableLanguage": "Japanese"
        },
        "areaServed": {
          "@type": "City",
          "name": "東京"
        },
        "knowsAbout": ["スペシャルティコーヒー", "自家焙煎", "グルテンフリー", "ペットフレンドリーカフェ", "ハンドドリップ"],
        "sameAs": [
          "https://www.instagram.com/green.beanscoffee",
          "https://www.youtube.com/@greenbeanscoffee9",
          "https://tabelog.com/tokyo/A1309/A130901/13277423"
        ]
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "トップ",
            "item": "https://greenbeanscoffeeambassador.com"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "ペット記事",
            "item": "https://greenbeanscoffeeambassador.com/pets/articles/"
          }{% if title and page.url != "/pets/articles/" %},
          {
            "@type": "ListItem",
            "position": 3,
            "name": {{ title | dump | safe }},
            "item": "https://greenbeanscoffeeambassador.com{{ page.url }}"
          }{% endif %}
        ]
      }
      {% if date %},
      {
        "@type": "BlogPosting",
        "headline": {{ title | dump | safe }},
        "description": {{ description | dump | safe }},
        "datePublished": "{{ date | dateISO }}",
        "dateModified": "{{ (updated or date) | dateISO }}",
        "author": {
          "@type": "Person",
          "@id": "https://greenbeanscoffeeambassador.com/pets/#ambassador-{{ (author or 'ayaka') | lower }}",
          "name": "{{ author or 'Ayaka' }}",
          "jobTitle": "GBCペットアンバサダー",
          "url": "https://greenbeanscoffeeambassador.com/pets/",
          "sameAs": [
            "https://greenbeanscoffeeambassador.com/pets/"{% if author == "Kikumi" %},
            "https://horikikumi.pages.dev/"{% endif %}
          ],
          "knowsAbout": ["ペットフレンドリーカフェ", "犬同伴カフェ", "スペシャルティコーヒー", "グルテンフリー"]
        },
        "publisher": {
          "@type": "Organization",
          "name": "Green Beans Coffee アンバサダーサイト",
          "url": "https://greenbeanscoffeeambassador.com"
        },
        "image": "https://greenbeanscoffeeambassador.com{% if thumbnail %}{{ thumbnail }}{% else %}/pets/assets/images/hero/hero-bg-1.jpg{% endif %}",
        "url": "https://greenbeanscoffeeambassador.com{{ page.url }}",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://greenbeanscoffeeambassador.com{{ page.url }}"
        },
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": ["h1", "h2", "article .prose > p:first-of-type"]
        }
      }
      {% endif %}
      {% if faqItems | length > 0 %},
      {
        "@type": "FAQPage",
        "mainEntity": [
          {% for item in faqItems %}
          {
            "@type": "Question",
            "name": {{ item.q | dump | safe }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ item.a | dump | safe }}
            }
          }{% if not loop.last %},{% endif %}
          {% endfor %}
        ]
      }
      {% endif %},
      {
        "@type": "WebSite",
        "name": "Green Beans Coffee アンバサダーサイト（ペットフレンドリー）",
        "url": "https://greenbeanscoffeeambassador.com/pets/",
        "potentialAction": {
          "@type": "SearchAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": "https://greenbeanscoffeeambassador.com/articles/?search={search_term_string}"
          },
          "query-input": "required name=search_term_string"
        }
      }
    ]
  }
  </script>
</head>

<body class="bg-[#FAF8F5] text-[#2D2A26] overflow-x-hidden">

  <!-- Navigation（ペット記事ページ専用：シンプル構成） -->
  <nav id="main-nav" class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md bg-white/80 shadow-md text-[#4A3728] transition-all duration-300">
    <div class="container mx-auto px-4 py-3 flex justify-between items-center">

      <!-- 左：ブランド + ナビ -->
      <div class="flex items-center gap-4 text-sm">
        <a href="https://greenbeanscoffeeambassador.com/pets/" class="font-semibold text-[#4A3728] hover:text-[#C9A86C] transition whitespace-nowrap" data-ga-event="click_store_page" data-ga-location="header_nav" data-content-group="pets">Green Beans Coffee</a>
        <span class="text-[#D0C4B0] hidden sm:block select-none">/</span>
        <span class="hidden sm:block text-xs font-bold text-[#4A3728]">ペット記事</span>
      </div>

      <!-- 右：各種リンク + モバイルメニューボタン -->
      <div class="flex items-center gap-3">
        <a href="/pets/" class="hidden sm:flex items-center gap-1.5 text-xs text-[#8B7355] hover:text-[#4A3728] transition whitespace-nowrap" data-ga-event="click_store_page" data-ga-location="header_nav" data-content-group="pets">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          ペットワンページ
        </a>
        <a href="/pets/articles/" class="hidden sm:flex items-center gap-1.5 text-xs text-[#8B7355] hover:text-[#4A3728] transition whitespace-nowrap">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
          記事一覧
        </a>

        <!-- Mobile menu button（スマホのみ） -->
        <button id="mobile-menu-btn" class="sm:hidden text-[#4A3728]" aria-label="メニューを開く">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu（スマホのみ） -->
    <div id="mobile-menu" class="hidden sm:hidden bg-white/95 backdrop-blur-md border-t border-[#E8E0D5]">
      <ul class="flex flex-col p-4 text-sm gap-1 text-[#4A3728]">
        <li>
          <a href="/pets/" class="flex items-center gap-2 py-2 hover:text-[#C9A86C] transition" data-ga-event="click_store_page" data-ga-location="mobile_nav" data-content-group="pets">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
            ペットワンページへ
          </a>
        </li>
        <li><a href="/pets/articles/" class="block py-2 font-bold">ペット記事一覧</a></li>
        <li><a href="/articles/" class="block py-2 text-xs text-[#8B7355]">GBC記事一覧（コラム）へ</a></li>
      </ul>
    </div>
  </nav>

  <!-- Main Content -->
  <div class="pt-16">
    {{ content | safe }}
  </div>

  <!-- Footer -->
  <footer class="bg-[#4A3728] text-white/70 text-center py-8 text-xs mt-16">
    <p class="mb-2 text-white/90 font-medium">Green Beans Coffee ペットアンバサダーサイト</p>
    <p class="mb-3">
      <a href="/pets/articles/" class="hover:text-[#C9A86C] transition">ペット記事一覧</a>
      <span class="mx-2 text-white/40">/</span>
      <a href="/pets/" class="hover:text-[#C9A86C] transition">ペットワンページ</a>
      <span class="mx-2 text-white/40">/</span>
      <a href="/" class="hover:text-[#C9A86C] transition">トップ</a>
    </p>
    <hr class="border-white/20 w-24 mx-auto mb-3">
    <p class="text-white/50">© 2026 GBCペットアンバサダー Ayaka. All rights reserved.</p>
  </footer>

  <script>
    document.getElementById('mobile-menu-btn').addEventListener('click', function() {
      document.getElementById('mobile-menu').classList.toggle('hidden');
    });

    // GA4: 店舗CTAリンクのクリック計測（data-ga-event属性を付けた要素のみ対象。既存のgtag.jsを利用し新規タグは追加しない。このレイアウトを使う全ページで1回だけ登録）
    // data-ga-location（article_cta / sidebar / header_nav / mobile_nav）はリンクの設置場所をGA4側で区別するためのパラメータ
    // data-article-category / data-article-slug は記事ページのCTAのみ付与。data-content-groupはペット領域を示す固定値"pets"
    document.querySelectorAll('[data-ga-event]').forEach(function (el) {
      el.addEventListener('click', function () {
        if (typeof gtag === 'function') {
          gtag('event', el.dataset.gaEvent, {
            link_url: el.href || undefined,
            link_location: el.dataset.gaLocation || undefined,
            article_category: el.dataset.articleCategory || undefined,
            article_slug: el.dataset.articleSlug || undefined,
            content_group: el.dataset.contentGroup || undefined
          });
        }
      });
    });

    // ① コピー時に著作権文言を自動付加
    document.addEventListener('copy', function(e) {
      const selection = window.getSelection();
      if (!selection || selection.toString().length < 10) return;
      const text = selection.toString();
      const attribution = '\n\n出典：Green Beans Coffee ペットアンバサダーサイト\n' + window.location.href + '\n© 2026 GBCペットアンバサダー Ayaka. All rights reserved.\n掲載コンテンツの無断転載・複製を禁じます。';
      e.clipboardData.setData('text/plain', text + attribution);
      e.preventDefault();
    });
    // ② 右クリック無効化
    document.addEventListener('contextmenu', function(e) {
      e.preventDefault();
    });
  </script>

</body>
</html>
